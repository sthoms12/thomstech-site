---
import BaseLayout from "../layouts/BaseLayout.astro";
import { PRINCIPLES, SITE, SOCIAL_LINKS, TOOLS } from "../data/site";
---

<BaseLayout>
  <section class="hero" aria-labelledby="hero-heading">
    <div class="container">
      <p class="hero-eyebrow">{SITE.author} &middot; {SITE.role}</p>
      <h1 class="hero-title" id="hero-heading">
        Practical, local-first tools for IT operations and Microsoft 365 teams.
      </h1>
      <p class="hero-lead">
        I lead enterprise Microsoft technology architecture and build fast, zero-account browser tools that take the friction out of IT renewals, technical troubleshooting, license optimization, and M365 visibility.
      </p>
      <div class="hero-actions">
        <a class="btn-primary" href="#tools" id="hero-cta">
          Explore IT tools
          <span aria-hidden="true">&darr;</span>
        </a>
        <div class="hero-links">
          {
            SOCIAL_LINKS.map((link) => (
              <a
                class="text-link"
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                id={`hero-${link.id}`}
              >
                {link.id === "x" ? `X (${link.handle})` : link.label}{" "}
                <span class="arrow" aria-hidden="true">&#8599;</span>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="tools" aria-labelledby="tools-heading">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="section-kicker">Featured Work</p>
          <h2 class="section-title" id="tools-heading">IT Operations &amp; M365 Tools</h2>
        </div>
        <p class="section-note">
          Four live web applications built to run directly in the browser or on Cloudflare's edge — free to use, with no sales funnel or mandatory signup.
        </p>
      </div>

      <div class="tools-grid">
        {
          TOOLS.map((tool) => (
            <article class="tool-card reveal" id={`card-${tool.id}`}>
              <div class="tool-card-top">
                <span class="tool-category">{tool.category}</span>
                <span class="tool-domain">{tool.domain}</span>
              </div>
              <h3 class="tool-name">{tool.name}</h3>
              <p class="tool-description">{tool.description}</p>
              <ul class="tool-specs" aria-label="Key capabilities">
                {tool.specs.map((spec) => <li>{spec}</li>)}
              </ul>
              <div class="tool-footer">
                <a
                  class="tool-cta"
                  href={tool.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  id={`link-${tool.id}`}
                >
                  {tool.ctaLabel} <span class="tool-cta-arrow" aria-hidden="true">&#8599;</span>
                </a>
                <span class="tool-hosting">{tool.hostingNote}</span>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="approach" aria-labelledby="approach-heading">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="section-kicker">Engineering Principles</p>
          <h2 class="section-title" id="approach-heading">How these tools are built</h2>
        </div>
      </div>

      <div class="principles-grid">
        {
          PRINCIPLES.map((item) => (
            <div class="principle reveal">
              <span class="principle-num">{item.number}</span>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="connect" aria-labelledby="connect-heading">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="section-kicker">About &amp; Connect</p>
          <h2 class="section-title" id="connect-heading">{SITE.author}</h2>
        </div>
      </div>

      <div class="connect-grid">
        <div class="reveal">
          <p class="about-copy">
            I'm a {SITE.role} focused on enterprise Microsoft 365 architecture, workplace governance, licensing strategy, and resilient IT operations.
          </p>
          <p class="about-copy">
            Outside of day-to-day leadership, I design and ship focused web utilities that solve the small but expensive problems IT teams run into every quarter. If you're working on similar challenges or have feedback on any of the tools above, feel free to connect.
          </p>
        </div>

        <ul class="connect-list reveal" aria-label="Social and professional links">
          {
            SOCIAL_LINKS.map((link) => (
              <li>
                <a
                  class="connect-link"
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  id={`connect-${link.id}`}
                >
                  <span class="connect-label">{link.label}</span>
                  <span class="connect-handle">{link.handle} &#8599;</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
