---
import "../styles/global.css";
import { SITE, SOCIAL_LINKS, TOOLS } from "../data/site";

interface Props {
  title?: string;
  description?: string;
}

const { title = SITE.title, description = SITE.description } = Astro.props;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://thomstech.com/#website",
      name: SITE.name,
      url: SITE.url,
      description: `Personal hub and IT operations tools showcase for ${SITE.author}, ${SITE.role}.`,
      author: { "@id": "https://thomstech.com/#person" },
    },
    {
      "@type": "Person",
      "@id": "https://thomstech.com/#person",
      name: SITE.author,
      jobTitle: SITE.role,
      url: SITE.url,
      sameAs: SOCIAL_LINKS.map((link) => link.url),
    },
    {
      "@type": "ItemList",
      "@id": "https://thomstech.com/#tools",
      name: "IT Operations & Microsoft 365 Tools",
      itemListElement: TOOLS.map((tool, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: tool.name,
        url: tool.url,
      })),
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0d1b24" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="author" content={SITE.author} />
    <meta name="description" content={description} />
    <link rel="canonical" href={SITE.url} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:url" content={SITE.url} />
    <meta property="og:title" content={`${SITE.author} — ${SITE.role} & IT Operations Tools`} />
    <meta
      property="og:description"
      content="Personal hub and IT operations tools showcase: My Renewal Desk, SolveStack, SeatLeak, and M365 Barometer."
    />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@thomstech12" />
    <meta name="twitter:creator" content="@thomstech12" />
    <meta name="twitter:title" content={`${SITE.author} — ${SITE.role} & IT Operations Tools`} />
    <meta
      name="twitter:description"
      content="Local-first, zero-account browser tools for IT renewals, troubleshooting, SaaS licensing, and Microsoft 365 visibility."
    />

    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/" id="nav-brand">
          <span class="brand-mark" aria-hidden="true">TT</span>
          <span>{SITE.domain}</span>
        </a>

        <div class="nav-group">
          <nav class="site-nav" aria-label="Primary">
            <a href="#tools" id="nav-tools">Tools</a>
            <a href="#approach" id="nav-approach">Approach</a>
            <a href="#connect" id="nav-connect">Connect</a>
          </nav>

          <button
            type="button"
            class="theme-toggle"
            id="theme-toggle"
            aria-label="Toggle color theme"
            title="Toggle color theme"
          >
            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
            </svg>
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="5" />
              <line x1="12" y1="1" x2="12" y2="3" />
              <line x1="12" y1="21" x2="12" y2="23" />
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
              <line x1="1" y1="12" x2="3" y2="12" />
              <line x1="21" y1="12" x2="23" y2="12" />
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <span>&copy; {SITE.author} &middot; {SITE.domain}</span>
        <span class="footer-meta">Astro Static &middot; Cloudflare Pages</span>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const toggleBtn = document.getElementById("theme-toggle");
        const STORAGE_KEY = "thomstech-theme";

        const getPreferredTheme = () => {
          const saved = localStorage.getItem(STORAGE_KEY);
          if (saved === "light" || saved === "dark") return saved;
          return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        };

        const applyTheme = (theme) => {
          root.setAttribute("data-theme", theme);
          if (toggleBtn) {
            const next = theme === "dark" ? "light" : "dark";
            toggleBtn.setAttribute("aria-label", `Switch to ${next} theme`);
            toggleBtn.setAttribute("title", `Switch to ${next} theme`);
          }
        };

        applyTheme(getPreferredTheme());

        if (toggleBtn) {
          toggleBtn.addEventListener("click", () => {
            const current = root.getAttribute("data-theme") === "dark" ? "dark" : "light";
            const next = current === "dark" ? "light" : "dark";
            localStorage.setItem(STORAGE_KEY, next);
            applyTheme(next);
          });
        }

        const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const revealNodes = document.querySelectorAll(".reveal");

        if (!prefersReducedMotion && "IntersectionObserver" in window && revealNodes.length > 0) {
          root.classList.add("js-enabled");
          const observer = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  entry.target.classList.add("is-visible");
                  observer.unobserve(entry.target);
                }
              }
            },
            { threshold: 0.08, rootMargin: "0px 0px -24px 0px" }
          );

          revealNodes.forEach((node) => observer.observe(node));
        }
      })();
    </script>
  </body>
</html>
